{
  "name": "mcp-servers",
  "version": "1.0.0",
  "description": "MCP Servers for Cursor/Claude Code integration",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "install:all": "npm install",
    "postgresql:start": "node postgresql/src/mcp-postgres-server.js",
    "postgresql:setup": "node postgresql/scripts/setup.cjs",
    "postgresql:test": "node postgresql/scripts/test.cjs",
    "notion:start": "node notion/src/server.js",
