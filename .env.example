PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# CORS allowlist (comma-separated). credentials: true
CORS_ORIGINS=http://localhost:3000

# Database: postgres
# Docker: docker compose -f docker-compose.dev.yml --profile postgres up -d
# Si el puerto host ya esta ocupado: POSTGRES_HOST_PORT=5433
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=mini_trainer_dev
TYPEORM_SYNC=false

# Caché de lecturas. Si se omite REDIS_HOST, usa memoria de proceso.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_ISSUER=mini-trainer
JWT_AUDIENCE=mini-trainer
JWT_EXPIRES_IN=7d

# Email. console by default; smtp uses the SMTP_* variables below.
EMAIL_DRIVER=console
# EMAIL_DRIVER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com
